{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "foreground": "lightGreen",
          "template": "{{ if .SSHSession }} {{ .UserName }}@{{ .HostName }} <#ffffff>in</> {{ end }}"
        },
        {
          "foreground": "lightBlue",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3
          },
          "style": "plain",
          "template": "{{ .Path }} ",
          "type": "path"
        },
        {
          "foreground": "#ff94df",
          "options": {
            "branch_icon": " <#ff94df><b>\ue0a0 </b></>",
            "fetch_status": true,
            "fetch_push_status": true,
            "status_formats": {
              "Added": "\uf055 %d  ",
              "Deleted": "\uf1f8 %d  ",
              "Modified": "\uf044 %d  ",
              "Untracked": "\uf059 %d  ",
              "Unmerged": "\uf071 %d  "
            }
          },
          "style": "plain",
          "template": "<#ffffff>on</> {{ .HEAD }}{{ if .Working.Changed }} {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .Ahead 0 }} \uf062 {{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} \uf063 {{ .Behind }}{{ end }} ",
          "type": "git"
        },
        {
          "foreground": "#ffd43b",
          "style": "plain",
          "template": "<#ffffff>using</> \ue235 {{ .Venv }} ",
          "type": "python",
          "options": {
            "display_mode": "environment",
            "fetch_virtual_env": true,
            "fetch_version": false,
            "display_default": false
          }
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "lightGreen",
          "style": "plain",
          "template": "\u276f",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
